# ╔═══════════════════════════════════════════════════════════════╗
# ║  WhatsApp Commerce OS — Environment Variables                ║
# ║  Copy this file to .env and fill in real values              ║
# ╚═══════════════════════════════════════════════════════════════╝

# ─── Application & Public Tunnels ──────────────────────────────
NODE_ENV=development
PORT=3002
# Public Base URL for PhonePe webhooks & mobile checkout links.
# For mobile testing via ngrok / Cloudflare Tunnel, set this to your active HTTPS tunnel:
# e.g., APP_BASE_URL="https://your-tunnel-url.ngrok-free.app"
APP_BASE_URL=http://localhost:3002
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3002
API_URL=http://localhost:3002
DASHBOARD_URL=http://localhost:3001

# ─── Supabase (PostgreSQL) ─────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → Database
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Redis (Upstash) ──────────────────────────────────────────
# Get these from: https://console.upstash.com → Redis → Database Details
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379
UPSTASH_REDIS_REST_URL=https://[endpoint].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Evolution API (WhatsApp) ─────────────────────────────────
# Self-hosted Evolution API instance
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-global-key
EVOLUTION_WEBHOOK_SECRET=your-webhook-verification-secret

# ─── AI Providers ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_AI_API_KEY=your-google-ai-key

# ─── AI Model Defaults ────────────────────────────────────────
AI_INTENT_MODEL=gpt-4o-mini
AI_RESPONSE_MODEL=gpt-4.1
AI_VISION_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Razorpay (Payments) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── PhonePe (Payments — Mobile Primary) ─────────────────────
# Used as primary gateway for Android / iOS customers
# UAT sandbox: get keys from https://developer.phonepe.com/v1/reference/pay-endpoint-1
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_ENVIRONMENT=sandbox

# ─── Security ─────────────────────────────────────────────────
MASTER_ENCRYPTION_KEY=generate-a-256-bit-key-here
JWT_SECRET=your-jwt-secret-min-32-chars
API_RATE_LIMIT_PER_MINUTE=60

# ─── Observability ────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=https://your-sentry-dsn

# ─── Email (Alerts) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key

# ─── Image Storage (Cloudflare R2) ────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=wcos-images
R2_PUBLIC_URL=https://images.yourdomain.com
