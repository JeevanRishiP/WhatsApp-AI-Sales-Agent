# Dedicated Cell / Pod Environment Template (Copy to .env.cell.<tenant> and fill unique secrets)
CELL_ID=cell-01
NODE_ENV=production

# Database & Redis Passwords (unique per Cell!)
CELL_DB_USER=wcos_cell
CELL_DB_PASSWORD=REPLACE_WITH_UNIQUE_32CHAR_DB_PASSWORD
CELL_DB_NAME=wcos_cell
CELL_REDIS_QUEUE_PASSWORD=REPLACE_WITH_UNIQUE_32CHAR_QUEUE_PASS
CELL_REDIS_CACHE_PASSWORD=REPLACE_WITH_UNIQUE_32CHAR_CACHE_PASS

# Cryptographic Keys (NEVER share across independent dedicated Cells)
JWT_SECRET=REPLACE_WITH_UNIQUE_64_HEX_JWT_SECRET
ENCRYPTION_MASTER_KEY=REPLACE_WITH_UNIQUE_64_HEX_AES_MASTER_KEY
CUSTOMER_JWT_SECRET=REPLACE_WITH_UNIQUE_64_HEX_CUSTOMER_JWT_SECRET
ADMIN_API_KEY=REPLACE_WITH_UNIQUE_ADMIN_API_KEY

# Public Endpoints & CORS
APP_BASE_URL=https://api.tenant-domain.com
PUBLIC_API_URL=https://api.tenant-domain.com
PUBLIC_STOREFRONT_URL=https://shop.tenant-domain.com
STOREFRONT_URL=https://shop.tenant-domain.com
STOREFRONT_ROOT_DOMAIN=shop.tenant-domain.com
ALLOWED_ORIGINS=https://dashboard.tenant-domain.com,https://shop.tenant-domain.com
TRUST_PROXY=1
ENABLE_PAYMENT_SIMULATOR=false
ENABLE_DEMO_LOGIN=false

# WhatsApp / Evolution / Meta Credentials
EVOLUTION_API_GLOBAL_KEY=REPLACE_WITH_CELL_EVOLUTION_KEY
EVOLUTION_PUBLIC_URL=https://wa.tenant-domain.com
META_APP_SECRET=REPLACE_IF_USING_META_CLOUD_API
META_WEBHOOK_VERIFY_TOKEN=REPLACE_IF_USING_META_CLOUD_API

# Durable Media Storage (Cloudflare R2 / S3)
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_BUCKET=wcos-media-cell-01
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
R2_PUBLIC_URL=https://cdn.tenant-domain.com

# Default Platform Fallbacks (tenant-level encrypted vault overrides take priority)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CELL_WORKER_REPLICAS=2

